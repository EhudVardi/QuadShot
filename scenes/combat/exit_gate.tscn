[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/combat/exit_gate.gd" id="1_xgate"]
[ext_resource type="Shader" path="res://resources/portal.gdshader" id="2_portal"]

; The ring that holds the pool. Dropped from energy 3.0 with the stargate
; rewrite: at 3.0 the four bars bloomed into one white slab, and a frame that
; is brighter than the surface it frames is not a frame.
[sub_resource type="StandardMaterial3D" id="mat_exit"]
albedo_color = Color(0.14, 0.4, 0.72, 1)
emission_enabled = true
emission = Color(0.15, 0.55, 1, 1)
emission_energy_multiplier = 1.15

; CIRCULAR as of v1.93 (the user's call). The ring's collision is built in
; exit_gate.gd from a fan of boxes rather than a trimesh: a torus is a bad
; collision shape and a stargate you can fly through the frame of is not a
; gate.
[sub_resource type="TorusMesh" id="mesh_ring"]
material = SubResource("mat_exit")
inner_radius = 2.85
outer_radius = 3.15

[sub_resource type="ShaderMaterial" id="mat_portal"]
render_priority = -1
shader = ExtResource("2_portal")

[sub_resource type="QuadMesh" id="mesh_portal"]
material = SubResource("mat_portal")
size = Vector2(5.7, 5.7)

[sub_resource type="CylinderShape3D" id="shape_opening"]
radius = 2.7
height = 1.6

