[gd_scene load_steps=11 format=3]

; THE WAR ROOM (GAMEPLAY-DESIGN Iteration 13, P1.8). The theater as a hex table
; under a fixed camera, lit by the same look pass the game flies in — the map is
; data (WarView) and this scene is only where it gets a body.

[ext_resource type="Script" path="res://scripts/warroom/war_room.gd" id="1_room"]
[ext_resource type="Script" path="res://scripts/warroom/hex_table.gd" id="2_table"]
[ext_resource type="Script" path="res://scripts/environment/look_controller.gd" id="3_look"]
[ext_resource type="Resource" path="res://resources/default_look_config.tres" id="4_lookcfg"]

[sub_resource type="ProceduralSkyMaterial" id="sky_mat"]
sky_top_color = Color(0.04, 0.05, 0.09, 1)
sky_horizon_color = Color(0.16, 0.14, 0.2, 1)
sky_curve = 0.15
ground_horizon_color = Color(0.1, 0.09, 0.12, 1)
ground_bottom_color = Color(0.03, 0.03, 0.04, 1)

[sub_resource type="Sky" id="sky"]
sky_material = SubResource("sky_mat")

[sub_resource type="Environment" id="environment"]
background_mode = 2
sky = SubResource("sky")
ambient_light_source = 3
tonemap_mode = 4
tonemap_exposure = 1.0
ssao_enabled = true
ssao_radius = 1.2
ssao_intensity = 2.5
glow_enabled = true
glow_blend_mode = 1
glow_bloom = 0.15
glow_hdr_threshold = 1.0
fog_enabled = true
fog_light_color = Color(0.35, 0.34, 0.44, 1)
fog_sun_scatter = 0.1
fog_density = 0.004
fog_aerial_perspective = 0.5
fog_sky_affect = 0.3
adjustment_enabled = true
adjustment_contrast = 1.08
adjustment_saturation = 1.1

; The table's surface: dark and matte, so every emissive channel on it reads.
[sub_resource type="StandardMaterial3D" id="mat_surface"]
albedo_color = Color(0.045, 0.05, 0.07, 1)
roughness = 0.95

[sub_resource type="PlaneMesh" id="mesh_surface"]
material = SubResource("mat_surface")
size = Vector2(400, 400)

; Near-opaque. The default panel is translucent enough that a neon hex table
; reads straight through the debrief text sitting on top of it.
[sub_resource type="StyleBoxFlat" id="panel_dark"]
content_margin_left = 16.0
content_margin_top = 14.0
content_margin_right = 16.0
content_margin_bottom = 14.0
bg_color = Color(0.035, 0.04, 0.055, 0.96)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.38, 0.44, 0.56, 0.65)

[node name="WarRoom" type="Node3D"]
script = ExtResource("1_room")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("environment")

[node name="Sun" type="DirectionalLight3D" parent="."]
