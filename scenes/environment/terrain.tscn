[ext_resource type="Shader" path="res://resources/terrain_ground.gdshader" id="7_vshader"]
[ext_resource type="Script" path="res://scripts/environment/terrain_environment.gd" id="8_env"]

; THE GROUND IS THE TERRAIN NOW - there is no flat plane underneath it and no
; WorldBoundaryShape3D fallback, deliberately. A hidden infinite floor at y = 0
; would catch a pilot who flew into a valley below zero and stop them dead in
; mid-air on nothing, which is precisely the kind of invisible disagreement
; between what you see and what the game thinks that this project keeps finding
; the expensive way. If the terrain has a hole in it, that must be visible.
[sub_resource type="ShaderMaterial" id="mat_terrain"]
resource_local_to_scene = true
shader = ExtResource("7_vshader")
shader_parameter/color_low = Color(0.2, 0.24, 0.2, 1)
shader_parameter/color_mid = Color(0.34, 0.38, 0.3, 1)
shader_parameter/color_high = Color(0.5, 0.52, 0.45, 1)
shader_parameter/color_slope = Color(0.22, 0.21, 0.19, 1)
shader_parameter/height_low = -30.0
shader_parameter/height_high = 60.0
shader_parameter/slope_start = 0.88
shader_parameter/slope_end = 0.55
shader_parameter/grain_scale = 0.004
shader_parameter/grain_strength = 0.06
shader_parameter/cell_size = 4.0

