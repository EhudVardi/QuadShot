; NO AUTHORED Mesh/Collision CHILDREN: the ground is a stack of concentric detail
; rings created at runtime, one mesh each, and only the inner ones carry a
; collider. See `TerrainMesh` for why that makes a vast world cheaper than a
; dense small one.
[node name="Terrain" type="StaticBody3D" parent="."]
script = ExtResource("5_terrain")
terrain_config = ExtResource("6_tcfg")
terrain_seed = 4242
material = SubResource("mat_terrain")

; The pad rides on top of whatever the terrain does under it - placed by
; `TerrainMap._ready` rather than by a fixed transform here, because the ground
; height at the origin is a config away from changing.
[node name="SpawnPad" type="StaticBody3D" parent="."]

[node name="Mesh" type="MeshInstance3D" parent="SpawnPad"]
mesh = SubResource("mesh_pad")

[node name="Collision" type="CollisionShape3D" parent="SpawnPad"]
shape = SubResource("shape_pad")

[node name="SpawnPoint" type="Marker3D" parent="."]
