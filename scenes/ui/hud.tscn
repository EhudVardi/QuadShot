[node name="SummaryLabel" type="Label" parent="Summary"]
theme_override_font_sizes/font_size = 22
text = ""
horizontal_alignment = 1
vertical_alignment = 1

; THE HULL BAR AND THE HEAT BAR ARE BOTH GONE (2026-08-15, the human's redesign).
; Hull is now the airframe's own silhouette on the AIRFRAME plate, which sits in
; exactly the space these two used to occupy - between the stick boxes - and the
; blaster's heat is a half ring around the aiming point, because heat is the one
; readout you consult WHILE aiming. Both are drawn by hud.gd rather than being
; ProgressBar nodes; see ComponentStatus._hull_body and WeaponGauge.

; THE AMMO LABEL IS GONE (2026-08-16), and so is the plate's "AIRFRAME" caption.
; Both were left over from before the magazine counts moved onto rings at the
; AIMING POINT, and flying the result settled the argument that had kept them:
; the rings carry the same label and the same number where the pilot is already
; looking, so this line was a duplicate reading competing for the same glance.
; See `GameHud.set_ammo`.

[node name="Title" type="VBoxContainer" parent="."]
anchor_left = 0.5
anchor_top = 0.32
anchor_right = 0.5
anchor_bottom = 0.32
offset_left = -300.0
offset_top = -70.0
offset_right = 300.0
offset_bottom = 90.0
mouse_filter = 2
theme_override_constants/separation = 10

[node name="TitleName" type="Label" parent="Title"]
theme_override_font_sizes/font_size = 56
text = "QUADSHOT"
horizontal_alignment = 1

[node name="TitleHint" type="Label" parent="Title"]
theme_override_font_sizes/font_size = 20
text = "throttle to zero, then A to arm and launch"
